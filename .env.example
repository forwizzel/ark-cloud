# Development-only values. Replace these before any non-local deployment.
POSTGRES_DB=arkcloud
POSTGRES_USER=arkcloud
POSTGRES_PASSWORD=replace-with-a-long-random-development-password
ARK_DATABASE_URL=postgresql+psycopg://arkcloud:replace-with-a-long-random-development-password@db:5432/arkcloud

ARK_ENVIRONMENT=development
ARK_LOG_LEVEL=INFO
ARK_SYSTEM_HOSTNAME=Ark
ARK_SYSTEM_OS_NAME=Fedora Linux
ARK_SYSTEM_STORAGE_PATH=/

# Optional Phase 1 integration. Leave blank to show Tailscale as not configured.
ARK_TAILSCALE_API_KEY=
ARK_TAILSCALE_TAILNET=-

# Keep the web service on loopback. Use `tailscale serve` for private remote access.
# Directly binding this port to a Tailscale IP is not supported by rootless Docker.
ARK_BIND_ADDRESS=127.0.0.1
ARK_WEB_PORT=5173

# Phase 2 local authentication. Generate an Argon2id hash and a random session secret;
# keep the actual values only in .env.
ARK_AUTH_USERNAME=
ARK_AUTH_PASSWORD_HASH=
ARK_SESSION_SECRET=
ARK_COOKIE_SECURE=false

# Optional Google Drive status integration. Configure this exact callback URL in the
# Google Cloud OAuth client and use a Fernet-compatible encryption key for refresh tokens.
ARK_GOOGLE_CLIENT_ID=
ARK_GOOGLE_CLIENT_SECRET=
ARK_GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/integrations/google-drive/oauth/callback
ARK_GOOGLE_TOKEN_ENCRYPTION_KEY=
ARK_GOOGLE_STATUS_CACHE_SECONDS=300
