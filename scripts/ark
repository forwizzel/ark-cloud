#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
    cat <<'EOF'
Usage: ./scripts/ark <command> [arguments]

Commands:
  up                         Build, recreate, and wait for the full stack
  down                       Stop and remove the stack, preserving volumes
  restart                    Freshly recreate the full stack, preserving volumes
  status                     Show service status
  health                     Check the browser-facing API health endpoint
  logs [service]             Follow logs for all services or one service
  exec SERVICE COMMAND...    Execute a command in a running service
  bootstrap                  Print a one-time first-administrator setup code
  reset-password USERNAME    Reset a local user's password (hidden prompt)
  recover-admin USERNAME     Restore administrator access (hidden prompt)
  storage init [--path DIR]   Provision a NEW local-files directory (owner only)
  storage setup [--path DIR] [--shared] Create private or shared Local Files storage
  storage add [options]       Assign an existing host directory; see storage add --help
  storage list               Show host-owned storage configuration
  storage users              Show immutable account IDs for assignment
  storage check              Verify mounts and file operations as the API user
  storage remove ID --confirm Unregister a root without deleting its files
  storage refresh-identity ID --confirm Accept a reviewed disk/root replacement
  storage manager enroll --approve DIR --install Install the UI storage manager once
  reset-data --confirm       Remove the stack and all named volumes
EOF
}

fail() {
    printf 'ark: %s\n' "$1" >&2
    exit 1
}

require_tools() {
    command -v docker >/dev/null 2>&1 || fail "Docker is required."
    docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required."
    command -v curl >/dev/null 2>&1 || fail "curl is required for health checks."
}

require_env() {
    [[ -f "$ROOT/.env" ]] || fail "Missing .env. Run: cp .env.example .env"
}

compose() {
    # Loopback is the supported and safe published address. Use Tailscale Serve for remote access.
    local files=(-f "$ROOT/compose.yaml")
    if [[ -f "$ROOT/compose.storage.yaml" ]]; then
        files+=(-f "$ROOT/compose.storage.yaml")
    fi
    ARK_BIND_ADDRESS=127.0.0.1 docker compose "${files[@]}" "$@"
}

validate_compose() {
    compose config --quiet || fail "Compose configuration is invalid. Check .env and compose.yaml."
}

prepare() {
    require_tools
    require_env
    validate_compose
}

storage_manager_service() {
    local action="$1"
    [[ -f "$ROOT/.ark-storage/manager.json" ]] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0
    if [[ "$action" == "stop" ]]; then
        if systemctl --user is-active --quiet ark-storage-manager.service 2>/dev/null; then
            systemctl --user stop ark-storage-manager.service
        fi
    elif systemctl --user is-enabled --quiet ark-storage-manager.service 2>/dev/null; then
        systemctl --user start ark-storage-manager.service
    fi
}

up() {
    prepare
    storage_manager_service stop
    trap 'storage_manager_service start' EXIT
    python3 "$ROOT/scripts/storage_health.py"
    local attempts=0
    until compose up --build --force-recreate --remove-orphans --detach --wait; do
        # At most 32 registered roots can disappear between validation and bind
        # creation. Retry only while the verified mount set actually changes.
        attempts=$((attempts + 1))
        [[ "$attempts" -le 32 ]] || return 1
        python3 "$ROOT/scripts/storage_health.py" --require-change || return 1
    done
    health
    python3 "$ROOT/scripts/storage_bootstrap.py"
    trap - EXIT
}

down() {
    prepare
    storage_manager_service stop
    compose down --remove-orphans
}

restart() {
    prepare
    storage_manager_service stop
    trap 'storage_manager_service start' EXIT
    python3 "$ROOT/scripts/storage_health.py"
    down
    up
}

status() {
    prepare
    compose ps
}

health() {
    prepare
    local binding port
    binding="$(compose port web 5173 2>/dev/null || true)"
    [[ -n "$binding" ]] || fail "The web service is not publishing port 5173. Run: ./scripts/ark up"
    port="${binding##*:}"
    curl --fail --show-error "http://127.0.0.1:${port}/api/health"
    printf '\n'
}

logs() {
    prepare
    compose logs --follow --tail=200 "$@"
}

exec_service() {
    prepare
    [[ "$#" -ge 2 ]] || fail "Usage: ./scripts/ark exec SERVICE COMMAND..."
    compose exec "$@"
}

account_command() {
    prepare
    [[ "$#" -ge 1 ]] || fail "Missing account command."
    compose run --rm --no-deps api python -m app.auth.cli "$@"
}

reset_data() {
    [[ "${1:-}" == "--confirm" && "$#" -eq 1 ]] || fail "This destroys PostgreSQL data. Use: ./scripts/ark reset-data --confirm"
    prepare
    storage_manager_service stop
    printf 'Removing containers, networks, accounts, Tailscale identity and secrets, and named volumes. Host files survive; restore account IDs and storage configuration to recover access.\n'
    compose down --volumes --remove-orphans
}

storage() {
    case "${1:-}" in
        setup) shift; python3 "$ROOT/scripts/storage_setup.py" "$@" ;;
        manager) shift; python3 "$ROOT/scripts/storage_manager.py" "$@" ;;
        check|users) prepare; compose exec api python -m app.services.storage_cli "$1" ;;
        *) python3 "$ROOT/scripts/storage.py" "$@" ;;
    esac
}

main() {
    local command="${1:-}"
    shift || true

    case "$command" in
        up) up "$@" ;;
        down) down "$@" ;;
        restart) restart "$@" ;;
        status) status "$@" ;;
        health) health "$@" ;;
        logs) logs "$@" ;;
        exec) exec_service "$@" ;;
        bootstrap) account_command bootstrap "$@" ;;
        reset-password) account_command reset-password "$@" ;;
        recover-admin) account_command recover-admin "$@" ;;
        storage) storage "$@" ;;
        reset-data) reset_data "$@" ;;
        help|-h|--help) usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

main "$@"
